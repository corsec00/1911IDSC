@page
@model CompetitionApp.Pages.Results.FinalModel
@using CompetitionApp.Pages.Configuration
@{
    ViewData["Title"] = "Resultados Finais";
    var config = PenaltyConfigModel.GetCurrentConfiguration();
}

<h1>Resultados Finais da Competição</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Sucesso!</strong> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-3">
    <a asp-page="/Configuration/PenaltyConfig" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-gear"></i> Configurar Penalidades
    </a>
</div>

@if (Model.FinalResults.Count == 0)
{
    <div class="alert alert-warning">
        Não há resultados suficientes para gerar a classificação final. Certifique-se de registrar os resultados das duas rodadas antes de visualizar os resultados finais.
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Classificação Final (Baseada no Melhor Tempo)</span>
            <form method="post" asp-page-handler="SaveToStorage">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-cloud-upload"></i> Salvar no Azure Storage
                </button>
            </form>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Posição</th>
                            <th>Nome</th>
                            <th>Melhor Tempo</th>
                            <th>Rodada do Melhor Tempo</th>
                            <th>Tempo Rodada 1</th>
                            <th>Tempo Rodada 2</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.FinalResults.Count; i++)
                        {
                            var result = Model.FinalResults[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@result.Name</td>
                                <td>@(result.BestTime == config.DisqualifiedValue ? "Desclassificado" : $"{result.BestTime:F2}s")</td>
                                <td>@result.BestRound</td>
                                <td>@(result.Round1Time == config.DisqualifiedValue ? "Desclassificado" : (result.Round1Time.ToString("F2") + "s"))</td>
                                <td>@(result.Round2Time == config.DisqualifiedValue ? "Desclassificado" : (result.Round2Time.ToString("F2") + "s"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Detalhes da Rodada 1</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Tempo Base</th>
                                    <th>Alfa</th>
                                    <th>Bravo</th>
                                    <th>Charlie</th>
                                    <th>Miss</th>
                                    <th>Fault</th>
                                    <th>Vítima</th>
                                    <th>Plate</th>
                                    <th>Total Marcadores</th>
                                    <th>Tempo Final</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in Model.Round1Results.OrderBy(r => r.CalculateTotalTime()))
                                {
                                    <tr>
                                        <td>@result.Name</td>
                                        <td>@result.TimeInSeconds.ToString("F2")s</td>
                                        <td>@result.AlfaCount</td>
                                        <td>@result.BravoCount</td>
                                        <td>@result.CharlieCount</td>
                                        <td>@result.MissCount</td>
                                        <td>@result.FaltaCount</td>
                                        <td>@result.VitimaCount</td>
                                        <td>@result.PlateCount</td>
                                        <td>@(result.AlfaCount + result.BravoCount + result.CharlieCount + result.MissCount + result.FaltaCount + result.VitimaCount + result.PlateCount)</td>
                                        <td>
                                            @if (result.CalculateTotalTime() >= config.DisqualifiedValue)
                                            {
                                                <span class="text-danger">DESCLASSIFICADO</span>
                                            }
                                            else
                                            {
                                                @result.CalculateTotalTime().ToString("F2")<text>s</text>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Detalhes da Rodada 2</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Tempo Base</th>
                                    <th>Alfa</th>
                                    <th>Bravo</th>
                                    <th>Charlie</th>
                                    <th>Miss</th>
                                    <th>Fault</th>
                                    <th>Vítima</th>
                                    <th>Plate</th>
                                    <th>Total Marcadores</th>
                                    <th>Tempo Final</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in Model.Round2Results.OrderBy(r => r.CalculateTotalTime()))
                                {
                                    <tr>
                                        <td>@result.Name</td>
                                        <td>@result.TimeInSeconds.ToString("F2")s</td>
                                        <td>@result.AlfaCount</td>
                                        <td>@result.BravoCount</td>
                                        <td>@result.CharlieCount</td>
                                        <td>@result.MissCount</td>
                                        <td>@result.FaltaCount</td>
                                        <td>@result.VitimaCount</td>
                                        <td>@result.PlateCount</td>
                                        <td>@(result.AlfaCount + result.BravoCount + result.CharlieCount + result.MissCount + result.FaltaCount + result.VitimaCount + result.PlateCount)</td>
                                        <td>
                                            @if (result.CalculateTotalTime() >= config.DisqualifiedValue)
                                            {
                                                <span class="text-danger">DESCLASSIFICADO</span>
                                            }
                                            else
                                            {
                                                @result.CalculateTotalTime().ToString("F2")<text>s</text>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0">Resumo da Competição</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <strong>Total de Participantes:</strong><br>
                        @Model.FinalResults.Count
                    </div>
                    <div class="col-md-3">
                        <strong>Participantes Classificados:</strong><br>
                        @Model.FinalResults.Count(r => r.BestTime < config.DisqualifiedValue)
                    </div>
                    <div class="col-md-3">
                        <strong>Participantes Desclassificados:</strong><br>
                        @Model.FinalResults.Count(r => r.BestTime >= config.DisqualifiedValue)
                    </div>
                    <div class="col-md-3">
                        <strong>Melhor Tempo Geral:</strong><br>
                        @{
                            var bestOverall = Model.FinalResults.Where(r => r.BestTime < config.DisqualifiedValue).OrderBy(r => r.BestTime).FirstOrDefault();
                        }
                        @if (bestOverall != null)
                        {
                            @($"{bestOverall.BestTime:F2}s ({bestOverall.Name})")
                        }
                        else
                        {
                            <text>N/A</text>
                        }
                    </div>
                </div>
                
                <div class="row mt-3">
                    <div class="col-12">
                        <strong>Configuração de Penalidades Utilizada:</strong><br>
                        <small class="text-muted">
                            Alfa: @config.AlfaValue s | 
                            Bravo: @config.BravoValue s | 
                            Charlie: @config.CharlieValue s | 
                            Miss: @config.MissValue s | 
                            Fault: @config.FaultValue s | 
                            Vítima: @config.VitimaValue s | 
                            Plate: @config.PlateValue s
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/Results/ExportPdf" class="btn btn-success">
            <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
        </a>
        <a asp-page="/Index" class="btn btn-secondary">
            <i class="bi bi-house"></i> Voltar ao Início
        </a>
    </div>
}

