@page
@model CompetitionApp.Pages.DiagnosticModel
@{
    ViewData["Title"] = "Diagnóstico Azure Storage";
}

<div class="container-fluid">
    <h1>Diagnóstico de Conexão com Azure Storage</h1>
    <p class="text-muted">Esta página ajuda a diagnosticar problemas de conexão e recuperação de dados do Azure Storage.</p>

    <div class="row mb-3">
        <div class="col-md-6">
            <form method="post" asp-page-handler="TestConnection">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-play"></i> Executar Teste de Conexão Manual
                </button>
            </form>
        </div>
        <div class="col-md-6">
            <a href="/Diagnostic" class="btn btn-secondary">
                <i class="fas fa-refresh"></i> Recarregar Diagnóstico
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Resultados do Diagnóstico</h3>
        </div>
        <div class="card-body">
            @if (Model.DiagnosticResults.Any())
            {
                <div class="bg-dark text-light p-3" style="font-family: 'Courier New', monospace; font-size: 14px; border-radius: 5px; max-height: 600px; overflow-y: auto;">
                    @foreach (var result in Model.DiagnosticResults)
                    {
                        <div>@result</div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">Nenhum resultado de diagnóstico disponível. Recarregue a página para executar o diagnóstico.</p>
            }
        </div>
    </div>

    <div class="mt-4">
        <div class="card">
            <div class="card-header">
                <h4>Como Interpretar os Resultados</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5>✓ Símbolos de Sucesso</h5>
                        <ul>
                            <li><strong>✓</strong> - Operação bem-sucedida</li>
                            <li><strong>CONFIGURADA</strong> - Variável de ambiente encontrada</li>
                            <li><strong>SUCESSO</strong> - Conexão estabelecida</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>✗ Símbolos de Erro</h5>
                        <ul>
                            <li><strong>✗</strong> - Operação falhou</li>
                            <li><strong>NÃO CONFIGURADA</strong> - Variável de ambiente ausente</li>
                            <li><strong>ERRO</strong> - Falha na operação</li>
                        </ul>
                    </div>
                </div>
                
                <hr>
                
                <h5>Problemas Comuns e Soluções</h5>
                <div class="accordion" id="troubleshootingAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                                Connection String não configurada
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#troubleshootingAccordion">
                            <div class="accordion-body">
                                <p>Se a variável <code>AZURE_STORAGE_CONNECTION_STRING</code> não estiver configurada:</p>
                                <ol>
                                    <li>Configure a variável de ambiente no sistema operacional</li>
                                    <li>Ou adicione a connection string no arquivo <code>appsettings.json</code></li>
                                    <li>Reinicie a aplicação após a configuração</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                    
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                Erro de autenticação
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#troubleshootingAccordion">
                            <div class="accordion-body">
                                <p>Se houver erros de autenticação:</p>
                                <ol>
                                    <li>Verifique se a AccountKey está correta</li>
                                    <li>Confirme se a conta de armazenamento existe</li>
                                    <li>Verifique as permissões de acesso</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                    
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                                Nenhum dado encontrado
                            </button>
                        </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#troubleshootingAccordion">
                            <div class="accordion-body">
                                <p>Se a conexão funciona mas não há dados:</p>
                                <ol>
                                    <li>Verifique se as competições foram salvas corretamente</li>
                                    <li>Confirme se está usando a conta de armazenamento correta</li>
                                    <li>Execute uma competição completa e salve no Azure Storage</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a href="/" class="btn btn-secondary">
            <i class="fas fa-home"></i> Voltar para Página Inicial
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
}

